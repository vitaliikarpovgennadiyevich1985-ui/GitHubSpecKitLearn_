@model CatalogPageViewModel

<div class="catalog-page-content">
    @if (Model.TotalCount == 0)
    {
        <div class="alert alert-light border" role="status">
            Catalog is currently empty.
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="alert alert-light border" role="status">
            No products are available for page @Model.PageNumber.
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model.Items)
            {
                <div class="product-card">
                    @if (!string.IsNullOrEmpty(product.Image))
                    {
                        <img src="data:image/bmp;base64,@product.Image"
                             alt=""
                             width="128"
                             height="128" />
                    }
                    else
                    {
                        <div class="product-img-placeholder"></div>
                    }
                    <div class="product-meta">
                        <span><strong>@product.Title</strong></span>
                        <span>@product.Description</span>
                        <span>@product.Price.ToString("C")</span>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.TotalPages > 0)
    {
        <div class="catalog-pager mt-3">
            <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <label for="catalog-page-size" class="form-label mb-0">Page size</label>
                    <select id="catalog-page-size" class="form-select form-select-sm" style="width: auto;" data-page-size>
                        @foreach (var size in Model.AvailablePageSizes)
                        {
                            <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-page="@(Model.PageNumber - 1)"
                            @(Model.PageNumber <= 1 ? "disabled" : null)>
                        Previous
                    </button>

                    @foreach (var pageNumber in Model.PageWindow)
                    {
                        if (pageNumber is null)
                        {
                            <span class="px-1" aria-hidden="true">...</span>
                        }
                        else if (pageNumber.Value == Model.PageNumber)
                        {
                            <span class="badge text-bg-primary">@pageNumber.Value</span>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm"
                                    data-page="@pageNumber.Value">
                                @pageNumber.Value
                            </button>
                        }
                    }

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-page="@(Model.PageNumber + 1)"
                            @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)>
                        Next
                    </button>
                </div>
            </div>

            <div class="mt-2 text-muted">Page @Model.PageNumber of @Model.TotalPages</div>
        </div>
    }
</div>
